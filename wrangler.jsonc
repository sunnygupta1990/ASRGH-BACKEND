{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "asrgh-api",
	"main": "src/worker.ts",
	"routes": [
		{
			"pattern": "aggarwalsabha.co.in/api/*",
			"zone_name": "aggarwalsabha.co.in"
		},
		{
			"pattern": "aggarwalsabha.co.in/media/*",
			"zone_name": "aggarwalsabha.co.in"
		}
	],
	"compatibility_date": "2026-08-15",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"vars": {
		"JWT_EXPIRES_IN": "8h",
		"PUBLIC_ORGANIZATION_CODE": "ASRGH",
		"PUBLIC_CACHE_TTL_SECONDS": "0"
	},
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "asrgh-media"
		}
	]
}